# Project ref: owpmwxoqpzwbsrrcmvpz (dashboard → Settings → General)
VITE_SUPABASE_URL=https://owpmwxoqpzwbsrrcmvpz.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# HTTPS app URL for YouTube Music bridge (required when running dev on http://localhost)
# Use your GitHub Pages URL, e.g. https://YOUR_USER.github.io/YTMQ
# Full GitHub Pages URL including repo path (no trailing slash)
# e.g. https://YOUR_USER.github.io/YTMQ
VITE_PUBLIC_SITE_URL=
# Spotify OAuth (PKCE). The Client ID is also baked into the app, so hosts
# only click Connect Spotify. Override here only if you use a different app.
# Redirect URIs on the Spotify dashboard must include:
#   http://localhost:5173/YTMQ/
#   https://YOUR_USER.github.io/YTMQ/
VITE_SPOTIFY_CLIENT_ID=431fa658f06e4078b3b79f20b41083f1
# Client secret is not used. Do not put it in VITE_ vars.
# YOUTUBE_API_KEY → set via: supabase secrets set YOUTUBE_API_KEY=...
