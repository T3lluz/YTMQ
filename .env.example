# Nothing here is required. The app talks to the server at its own origin
# (t3lluz.com/ytmq/api, or the Vite proxy in dev).

# Absolute API URL, only if it is not the app's own origin.
# VITE_API_URL=https://t3lluz.com/ytmq/api

# HTTPS site root the YouTube Music bridge loads from. Needed when you run
# the dev server on http://localhost and want to connect YouTube Music.
VITE_PUBLIC_SITE_URL=

# Spotify OAuth (PKCE). The Client ID is also baked into the app, so hosts
# only click Connect Spotify. Override here only if you use a different app.
# Redirect URIs on the Spotify dashboard must include:
#   http://127.0.0.1:5173/ytmq/   (Spotify rejects localhost)
#   https://t3lluz.com/ytmq/
VITE_SPOTIFY_CLIENT_ID=431fa658f06e4078b3b79f20b41083f1
