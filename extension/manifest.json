{
  "manifest_version": 3,
  "name": "YTMQ",
  "version": "1.9.1",
  "description": "Host companion for YTMQ: links YouTube Music to your lobby, shows the shared queue on YouTube Music, and puts the lobby in your toolbar.",
  "minimum_chrome_version": "102",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://t3lluz.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js",
        "ui.js",
        "ytm-panel.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://t3lluz.com/ytmq/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YTMQ"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
